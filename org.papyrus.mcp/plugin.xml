<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <!-- Start the bundle (and therefore the MCP server) once the workbench is up,
        so the bot can connect without the user opening any view. -->
   <extension point="org.eclipse.ui.startup">
      <startup class="org.papyrus.mcp.Startup"/>
   </extension>
   <!-- Preference page: Window > Preferences > Papyrus MCP (port, token, enable). -->
   <extension point="org.eclipse.ui.preferencePages">
      <page id="org.papyrus.mcp.prefs" name="Papyrus MCP"
            class="org.papyrus.mcp.McpPreferencePage"/>
   </extension>
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="org.papyrus.mcp.McpPreferenceInitializer"/>
   </extension>
</plugin>
